  m_EditorClassIdentifier: 
  txt: {fileID: 1630123718}
  currentType: 0
  languages:
  - type: 0
    content: "\"D\xF9ng g\u1EA1c c\u1EE7 \u1EA5u th\u1EA5m dung d\u1ECBch NaCl 0,9%.
      R\u1EEDa t\u1EEB m\xE9p v\u1EBFt th\u01B0\u01A1ng ra b\xEAn ngo\xE0i da l\xE0nh
      r\u1ED3i b\u1ECF \u0111i. R\u1EEDa t\u1EEB ch\xEDnh gi\u1EEFa v\u1EBFt th\u01B0\u01A1ng
      ra m\xE9p v\u1EBFt th\u01B0\u01A1ng r\u1ED3i b\u1ECF \u0111i. L\u01B0u \xFD:
      R\u1EEDa b\u1EB1ng c\xE1ch th\u1EA5m nh\u1EB9, kh\xF4ng c\u1ECD x\xE1t m\u1EA1nh.\"\t\t\t"
  - type: 1
    content: '"Use gauze soaked in 0.9% NaCl solution.  Wash from the edge of the
      wound to the outside of the healthy skin and discard.  Wash from the center
      of the wound to the edge of the wound and discard.  Note: Wash by gently patting,
      do not rub hard."'
