--- !u!114 &1102022700
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1102022696}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6c2b3f36def609548a9bf722d851a085, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  txt: {fileID: 1102022698}
  currentType: 0
  languages:
  - type: 0
    content: "\"\u0110i\u1EC1u d\u01B0\u1EE1ng th\xE1o g\u0103ng c\u0169, \u0111\u1ED5
      dung d\u1ECBch (NaCl 0,9% v\xE0 Betadin) ra b\xE1t k\u1EC1n. (L\u01B0u \xFD:
      Kh\xF4ng \u0111\u1EC3 \u0111\u1EA7u chai d\u1ECBch ch\u1EA1m v\xE0o b\xE1t
      k\u1EC1n) .  \u0110i\u1EC1u d\u01B0\u1EE1ng s\xE1t khu\u1EA9n tay, \u0111i
      g\u0103ng m\u1EDBi (v\xF4 khu\u1EA9n).\"\t\t\t"
  - type: 1
    content: '"The nurse removes the old gloves, pours the solution (0.9% NaCl and
      Betadin) into the nickel bowl. (Note: Do not let the tip of the solution bottle
      touch the nickel bowl).   The nurse disinfects her hands, puts on new gloves
      (sterile)."'
