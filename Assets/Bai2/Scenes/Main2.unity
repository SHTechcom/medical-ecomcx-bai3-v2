  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6c2b3f36def609548a9bf722d851a085, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  txt: {fileID: 273967038}
  currentType: 0
  languages:
  - type: 0
    content: "D\u1EE5ng c\u1EE5 v\xF4 khu\u1EA9n: H\u1ED9p d\u1EE5ng c\u1EE5 (b\xE1t
      k\u1EC1n, 2 k\xECm Kocher, 2 k\u1EB9p ph\u1EABu t\xEDch, 1 k\xE9o), g\u1EA1c,
      b\xF4ng c\u1EA7u D\u1EE5ng c\u1EE5 s\u1EA1ch (tr\xEAn xe \u0111\u1EA9y): Khay
      ch\u1EEF nh\u1EADt, k\xE9o, b\u0103ng d\xEDnh, 2 \u0111\xF4i g\u0103ng tay
      (1 s\u1EA1ch, 1 v\xF4 khu\u1EA9n), dung d\u1ECBch r\u1EEDa (NaCl 0,9%), dung
      d\u1ECBch s\xE1t khu\u1EA9n (Betadin). D\u1EE5ng c\u1EE5 kh\xE1c: Ch\u1EADu
      \u0111\u1EF1ng dung d\u1ECBch kh\u1EED khu\u1EA9n, nilon/t\u1EA5m l\xF3t, x\xF4
      \u0111\u1EF1ng r\xE1c th\u1EA3i y t\u1EBF, h\u1ED9p \u0111\u1EF1ng v\u1EADt
      s\u1EAFc nh\u1ECDn, chai s\xE1t khu\u1EA9n tay nhanh."
  - type: 1
    content: '"Sterile equipment: Tool box (nickel bowl, 2 Kocher forceps, 2 dissecting
      forceps, 1 scissors), gauze, cotton swab Clean equipment (on trolley): Rectangular
      tray, scissors, adhesive tape, 2 pairs of gloves (1 clean, 1 sterile), cleaning
      solution (0.9% NaCl), antiseptic solution (Betadin). Other equipment: Disinfectant
      solution basin, plastic/mat, medical waste bucket, sharps container, quick
      hand sanitizer bottle." '
