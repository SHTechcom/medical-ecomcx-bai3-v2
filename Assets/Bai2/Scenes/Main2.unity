  m_Script: {fileID: 11500000, guid: 6c2b3f36def609548a9bf722d851a085, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  txt: {fileID: 1271353682}
  currentType: 0
  languages:
  - type: 0
    content: "2. \"Ch\xE0o b\u1EA1n. T\xF4i l\xE0 \u0111i\u1EC1u d\u01B0\u1EE1ng
      Nguy\u1EC5n V\u0103n A. R\u1EA5t vui \u0111\u01B0\u1EE3c g\u1EB7p b\u1EA1n.
      H\xF4m nay, t\xF4i s\u1EBD ti\u1EBFn h\xE0nh thay b\u0103ng, r\u1EEDa v\u1EBFt
      th\u01B0\u01A1ng cho b\u1EA1n. B\u1EA1n \u0111\xE3 s\u1EB5n s\xE0ng ch\u01B0a?\""
  - type: 1
    content: 2. ""Hello. I am nurse Nguyen Van A. Nice to meet you. Today, I will
      change the bandage and clean your wound. Are you ready?"""
