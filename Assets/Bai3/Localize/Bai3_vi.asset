%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Bai3_vi
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: af7abde813b0c4237a91933232195aac, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 287526871040
    m_Localized: Giong Noi
    m_Metadata:
      m_Items: []
  - m_Id: 1820355600572416
    m_Localized: "h\u1ED3 s\u01A1 b\u1EC7nh \xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 1820359228645376
    m_Localized: "Gi\u1EDBi thi\u1EC7u b\u1EA3n th\xE2n, gi\u1EA3i th\xEDch m\u1EE5c
      \u0111\xEDch v\xE0 quy tr\xECnh cho \u0103n \u0111\u1EC3 ng\u01B0\u1EDDi b\u1EC7nh
      h\u1EE3p t\xE1c.\t\t\t"
    m_Metadata:
      m_Items: []
  - m_Id: 1820364756738048
    m_Localized: "H\u01B0\u1EDBng d\u1EABn ng\u01B0\u1EDDi b\u1EC7nh t\u01B0 th\u1EBF
      v\xE0 nh\u1EEFng \u0111i\u1EC1u c\u1EA7n l\u01B0u \xFD trong qu\xE1 tr\xECnh
      cho \u0103n.\t\t\t"
    m_Metadata:
      m_Items: []
  - m_Id: 1820367973769216
    m_Localized: "Ch\xE0o h\u1ECFi, Gi\u1EA3i Th\xEDch"
    m_Metadata:
      m_Items: []
  - m_Id: 1928428226863104
    m_Localized: "Danh s\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 1931559274799104
    m_Localized: "M\u0169"
    m_Metadata:
      m_Items: []
  - m_Id: 1931563582349312
    m_Localized: "\xC1o cho\xE0ng v\xF4 khu\u1EA9n"
    m_Metadata:
      m_Items: []
  - m_Id: 1931566623219712
    m_Localized: "G\u0103ng tay"
    m_Metadata:
      m_Items: []
  - m_Id: 1931569907359744
    m_Localized: "\u1ED0ng Nghe"
    m_Metadata:
      m_Items: []
  - m_Id: 1940842854998016
    m_Localized: "\u0110\u1EA3m b\u1EA3o m\u0169, kh\u1EA9u trang, \xE1o cho\xE0ng
      \u0111\u1EA7y \u0111\u1EE7 theo quy \u0111\u1ECBnh v\xF4 khu\u1EA9n c\u01A1
      b\u1EA3n."
    m_Metadata:
      m_Items: []
  - m_Id: 1942873325953024
    m_Localized: "Kh\u1EA9u trang"
    m_Metadata:
      m_Items: []
  - m_Id: 1944441630744576
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 1945117614137344
    m_Localized: "R\u1EEDa tay 6 b\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 2054517716672512
    m_Localized: "Th\u1EF1c hi\u1EC7n s\xE1t khu\u1EA9n tay 6 b\u01B0\u1EDBc \u0111\u1EC3
      \u0111\u1EA3m b\u1EA3o v\xF4 khu\u1EA9n tr\u01B0\u1EDBc khi chu\u1EA9n b\u1ECB
      d\u1EE5ng c\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 2056538582671360
    m_Localized: "Ch\u1ECDn d\u1EE5ng c\u1EE5 y t\u1EBF"
    m_Metadata:
      m_Items: []
  - m_Id: 2057929854279680
    m_Localized: Remind and encourage the patient to cooperate to make the catheter
      insertion process easier.
    m_Metadata:
      m_Items: []
  - m_Id: 2058709357289472
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 2062041572433920
    m_Localized: "Che b\xECnh phong"
    m_Metadata:
      m_Items: []
  - m_Id: 2062190138875904
    m_Localized: "D\u1EF1ng b\xECnh phong \u0111\u1EC3 t\u1EA1o kh\xF4ng gian k\xEDn
      \u0111\xE1o, t\xF4n tr\u1ECDng ng\u01B0\u1EDDi b\u1EC7nh tr\u01B0\u1EDBc khi
      ti\u1EBFn h\xE0nh th\u1EE7 thu\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 2063126567575552
    m_Localized: "\u0110\u01B0a xe \u0111\u1EA9y/khay d\u1EE5ng c\u1EE5 \u0111\xE3
      chu\u1EA9n b\u1ECB \u0111\u1EBFn c\u1EA1nh gi\u01B0\u1EDDng ng\u01B0\u1EDDi
      b\u1EC7nh"
    m_Metadata:
      m_Items: []
  - m_Id: 2064080415219712
    m_Localized: "N\xE2ng gi\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 2064659099148288
    m_Localized: "\u0110\u1EB7t ng\u01B0\u1EDDi b\u1EC7nh n\u1EB1m ng\u1EEDa, \u0111\u1EA7u
      cao  30 \u0111\u1ED9 - 60 \u0111\u1ED9 (t\u01B0 th\u1EBF Fowler) \u0111\u1EC3
      tr\xE1nh s\u1EB7c v\xE0 thu\u1EADn ti\u1EC7n cho thao t\xE1c.\t\t"
    m_Metadata:
      m_Items: []
  - m_Id: 2065547280769024
    m_Localized: "Che nilon/kh\u0103n b\xF4ng \u0111\u1EC3 b\u1EA3o v\u1EC7 qu\u1EA7n
      \xE1o, chu\u1EA9n b\u1ECB b\u0103ng d\xEDnh v\xE0 v\u1EC7 sinh m\u0169i (v\u1ECB
      tr\xED lu\u1ED3n \u1ED1ng) s\u1EA1ch s\u1EBD."
    m_Metadata:
      m_Items: []
  - m_Id: 2068371070771200
    m_Localized: "\u0110o \u1ED0ng Th\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2068409360572416
    m_Localized: "C\u1EA7m \u1ED1ng th\xF4ng \u0111\xFAng c\xE1ch (ki\u1EC3u c\u1EA7m
      b\xFAt) v\xE0 \u0111\u01B0a \u1ED1ng d\u1EE9t kho\xE1t v\xE0o m\u0169i \u0111\u1EBFn
      kho\u1EA3ng 10cm"
    m_Metadata:
      m_Items: []
  - m_Id: 2070373431500800
    m_Localized: "\u0111\xE8 l\u01B0\u1EE1i ki\u1EC3m tra, n\u1EBFu \u1ED1ng kh\xF4ng
      cu\u1ED9n, ti\u1EBFp t\u1EE5c lu\u1ED3n theo nh\u1ECBp nu\u1ED1t v\xE0 \u0111\u01B0a
      \u1ED1ng \u0111\u1EBFn v\u1EA1ch \u0111\xE1nh d\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 2070555023892480
    m_Localized: "\u0110\u01B0a \u1ED1ng v\xE0o d\u1EA1 d\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 2071500457762816
    m_Localized: Use one of three methods (aspirate, listen for sounds, check for
      bubbles) to confirm that the tube tip is in the stomach.
    m_Metadata:
      m_Items: []
  - m_Id: 2071707123703808
    m_Localized: "B\u01A1m kh\xED & nghe"
    m_Metadata:
      m_Items: []
  - m_Id: 2071709149552640
    m_Localized: "D\u1ECBch v\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 2071710609170432
    m_Localized: "Kh\xF4ng s\u1EE7i b\u1ECDt"
    m_Metadata:
      m_Items: []
  - m_Id: 2072378757603328
    m_Localized: "C\u1ED1 \u0110\u1ECBnh \u1ED0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2072445044383744
    m_Localized: "D\xF9ng b\u0103ng d\xEDnh c\u1ED1 \u0111\u1ECBnh \u1ED1ng th\xF4ng
      ch\u1EAFc ch\u1EAFn v\xE0o m\u0169i v\xE0 m\xE1/tr\xE1n, tr\xE1nh di l\u1EC7ch
      trong qu\xE1 tr\xECnh cho \u0103n."
    m_Metadata:
      m_Items: []
  - m_Id: 2072730705846272
    m_Localized: "Tr\xE1ng \u1ED0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2072799463071744
    m_Localized: "Tr\xE1ng \u1ED1ng b\u1EB1ng n\u01B0\u1EDBc ch\xEDn (10-15ml), sau
      \u0111\xF3 b\u01A1m th\u1EE9c \u0103n t\u1EEB t\u1EEB (\u0111\xE3 \u0111u\u1ED5i
      kh\xED) theo y l\u1EC7nh, v\xE0 cu\u1ED1i c\xF9ng tr\xE1ng l\u1EA1i \u1ED1ng
      b\u1EB1ng n\u01B0\u1EDBc (20ml) \u0111\u1EC3 tr\xE1nh t\u1EAFc ngh\u1EBDn.\t"
    m_Metadata:
      m_Items: []
  - m_Id: 2073813800968192
    m_Localized: "Cho \u0102n"
    m_Metadata:
      m_Items: []
  - m_Id: 2073998476173312
    m_Localized: "Tr\xE1ng \u1ED1ng b\u1EB1ng n\u01B0\u1EDBc ch\xEDn (10-15ml), sau
      \u0111\xF3 b\u01A1m th\u1EE9c \u0103n t\u1EEB t\u1EEB (\u0111\xE3 \u0111u\u1ED5i
      kh\xED) theo y l\u1EC7nh, v\xE0 cu\u1ED1i c\xF9ng tr\xE1ng l\u1EA1i \u1ED1ng
      b\u1EB1ng n\u01B0\u1EDBc (20ml) \u0111\u1EC3 tr\xE1nh t\u1EAFc ngh\u1EBDn.\t"
    m_Metadata:
      m_Items: []
  - m_Id: 2074912586981376
    m_Localized: "Tr\xE1ng \u1ED1ng b\u1EB1ng n\u01B0\u1EDBc ch\xEDn (10-15ml), sau
      \u0111\xF3 b\u01A1m th\u1EE9c \u0103n t\u1EEB t\u1EEB (\u0111\xE3 \u0111u\u1ED5i
      kh\xED) theo y l\u1EC7nh, v\xE0 cu\u1ED1i c\xF9ng tr\xE1ng l\u1EA1i \u1ED1ng
      b\u1EB1ng n\u01B0\u1EDBc (20ml) \u0111\u1EC3 tr\xE1nh t\u1EAFc ngh\u1EBDn.\t"
    m_Metadata:
      m_Items: []
  - m_Id: 2075008355524608
    m_Localized: "Tr\xE1ng \u1ED0ng l\u1EA7n 2"
    m_Metadata:
      m_Items: []
  - m_Id: 2075174655483904
    m_Localized: "Th\xE1o B\u0103ng D\xEDnh"
    m_Metadata:
      m_Items: []
  - m_Id: 2075386618830848
    m_Localized: Withdraw the tube gently and slowly. When the tube is almost completely
      withdrawn (15 - 20 cm), clamp or fold the tube to prevent gastric contents
      from flowing back out.
    m_Metadata:
      m_Items: []
  - m_Id: 2076597136908288
    m_Localized: "Ch\u0103m s\xF3c sau \u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 2076634654957568
    m_Localized: "Lau s\u1EA1ch mi\u1EC7ng v\xE0 m\u0169i, th\xE1o b\u1ECF kh\u0103n
      b\xF4ng v\xE0 nilon \u0111\u1EC3 l\xE0m s\u1EA1ch cho ng\u01B0\u1EDDi b\u1EC7nh."
    m_Metadata:
      m_Items: []
  - m_Id: 2077315570851840
    m_Localized: "Gi\u1EEF ng\u01B0\u1EDDi b\u1EC7nh \u0111\u1EA7u cao 30 - 60 \u0111\u1ED9
      trong 30 - 60 ph\xFAt \u0111\u1EC3 tr\xE1nh tr\xE0o ng\u01B0\u1EE3c v\xE0 theo
      d\xF5i s\xE1t c\xE1c d\u1EA5u hi\u1EC7u b\u1EA5t th\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2077666885754880
    m_Localized: "Theo d\xF5i 30-60 ph\xFAt"
    m_Metadata:
      m_Items: []
  - m_Id: 2077973665538048
    m_Localized: "Thu gom v\xE0 ph\xE2n lo\u1EA1i d\u1EE5ng c\u1EE5 b\u1EA9n, th\xE1o
      g\u0103ng theo quy tr\xECnh \u0111\u1EC3 \u0111\u1EA3m b\u1EA3o v\u1EC7 sinh."
    m_Metadata:
      m_Items: []
  - m_Id: 2078115147800576
    m_Localized: "Thu d\u1ECDn"
    m_Metadata:
      m_Items: []
  - m_Id: 2079098879860736
    m_Localized: "Th\u1EF1c hi\u1EC7n s\xE1t khu\u1EA9n tay sau khi k\u1EBFt th\xFAc
      c\xF4ng vi\u1EC7c v\xE0 thu d\u1ECDn d\u1EE5ng c\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 2098398739030016
    m_Localized: "M\u1EDF v\xE0 ghi nh\u1EADn c\xE1c th\xF4ng tin c\xE1 nh\xE2n v\xE0
      ti\u1EC1n s\u1EED b\u1EC7nh l\xFD c\u1EE7a ng\u01B0\u1EDDi b\u1EC7nh.\t\t\t"
    m_Metadata:
      m_Items: []
  - m_Id: 2135925210472448
    m_Localized: "Ho\xE0n T\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 2136811982807040
    m_Localized: "I. H\xE0nh ch\xEDnh"
    m_Metadata:
      m_Items: []
  - m_Id: 2137280675307520
    m_Localized: "H\u1ECD v\xE0 t\xEAn (In hoa):"
    m_Metadata:
      m_Items: []
  - m_Id: 2137442244091904
    m_Localized: "Ng\xE0y sinh"
    m_Metadata:
      m_Items: []
  - m_Id: 2137447424057344
    m_Localized: "Tu\u1ED5i"
    m_Metadata:
      m_Items: []
  - m_Id: 2139771584372736
    m_Localized: "Gi\u1EDBi t\xEDnh:"
    m_Metadata:
      m_Items: []
  - m_Id: 2140607928590336
    m_Localized: "D\xE2n t\u1ED9c:"
    m_Metadata:
      m_Items: []
  - m_Id: 2140888498167808
    m_Localized: "\u0110\u1ECBa ch\u1EC9 c\u01B0 tr\xFA:"
    m_Metadata:
      m_Items: []
  - m_Id: 2140973554458624
    m_Localized: "S\u1ED1 th\u1EBB BHYT:"
    m_Metadata:
      m_Items: []
  - m_Id: 2140975425118208
    m_Localized: 'CCCD:'
    m_Metadata:
      m_Items: []
  - m_Id: 2141441768808448
    m_Localized: "L\xFD do v\xE0o vi\u1EC7n:"
    m_Metadata:
      m_Items: []
  - m_Id: 2141479513350144
    m_Localized: "I. Lo\u1EA1i v\xE0 s\u1ED1 l\u01B0\u1EE3ng th\u1EE9c \u0103n "
    m_Metadata:
      m_Items: []
  - m_Id: 2141740868820992
    m_Localized: "\u0110i\u1EC1n lo\u1EA1i th\u1EE9c \u0103n v\xE0 s\u1ED1 l\u01B0\u1EE3ng
      th\u1EE9c \u0103n mu\u1ED1n b\u01A1m v\xE0o :"
    m_Metadata:
      m_Items: []
  - m_Id: 2141849585180672
    m_Localized: "Ti\u1EC1n s\u1EED d\u1ECB \u1EE9ng:"
    m_Metadata:
      m_Items: []
  - m_Id: 2141851325816832
    m_Localized: "Ng\xE0y / gi\u1EDD th\u1EF1c hi\u1EC7n:"
    m_Metadata:
      m_Items: []
  - m_Id: 2141852844154880
    m_Localized: "T\xECnh tr\u1EA1ng hi\u1EC7n t\u1EA1i:"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
